{
  "name": "interactivedesigner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:player && vite",
    "build:player": "vite build --config vite.player.config.ts",
    "build": "npm run build:player && tsc --noEmit && vite build && node scripts/make-sw.mjs && npm run build:offline-file",
    "preview": "vite preview",
    "typecheck": "npm run build:player && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build:app": "vite build",
    "build:offline-file": "vite build --config vite.single.config.ts && node scripts/copy-offline.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.2"
  }
}
